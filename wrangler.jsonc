{
  // Stránka a dáta v site/ sú statické súbory – na Cloudflare zadarmo a bez limitu.
  // Worker kód (worker/live.js) beží LEN na adrese /live (počítadlo návštevnosti),
  // takže denný limit 100 000 spustení účtu míňa iba počítadlo, a to s poistkou.
  "name": "vydavky-statu",
  "compatibility_date": "2025-09-01",
  "account_id": "c056bb00714059f0803d5261920db923",
  "workers_dev": true,
  "main": "worker/live.js",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/live"]
  },
  "durable_objects": { "bindings": [{ "name": "COUNTER", "class_name": "Counter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Counter"] }]
  // Platená verzia (vyhľadávanie v D1) – pridaj späť Worker kód a databázu:
  // ,"main": "worker/index.js"
  // ,"vars": { "GH_REPO": "jandokan/vydavky-statu" }
  // ,"assets": { "directory": "./site", "run_worker_first": ["/api/search", "/api/zmluva/*", "/api/plan"] }
  // ,"d1_databases": [{ "binding": "DB", "database_name": "vydavky-statu", "database_id": "<ID>" }]
}
