{
  // Cloudflare Worker + statické súbory. Nasadzuje GitHub Actions (deploy.yml / update.yml).
  // Statické súbory (stránka + dáta v site/) sú na Cloudflare zadarmo a bez limitu požiadaviek.
  // Worker sa spúšťa len pre /api/search, /api/zmluva/*, /api/plan a pre súbory, ktoré v site/ chýbajú.
  "name": "vydavky-statu",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "account_id": "c056bb00714059f0803d5261920db923",
  "workers_dev": true,
  "vars": { "GH_REPO": "jandokan/vydavky-statu" },
  "assets": {
    "directory": "./site",
    "run_worker_first": ["/api/search", "/api/zmluva/*", "/api/plan"]
  }
  // Platená verzia – odkomentuj po vytvorení D1 databázy (ID nájdeš v Cloudflare → D1):
  // ,"d1_databases": [{ "binding": "DB", "database_name": "vydavky-statu", "database_id": "<ID>" }]
}
