ovo 72, 04912 Bohúňovo","Fyzická osoba",null,null,"Príkazná zmluva",null,null,null,null,null,null,"2026-06-24","2026-07-04",null,"2026-07-03 09:24:47","2026-07-03 09:24:47",2640,2640,2,1,1,1,6215909,"0",null,null,null,null,null,[["Príloha č. 1","6856436.pdf",258895]],"bohunovo--roznava",null,null,0,null],[12670752,"7C0867CF-E60E-8DDE-8164-078396544538","Obec Bohúňovo","00328111","Bohúňovo 72, 04912 Bohúňovo","Danucem Slovensko a.s.","00214973","906 38 Rohožník","Darovacia zmluva",null,null,null,null,null,null,"2026-08-04","2026-08-11",null,"2026-08-10 14:30:37","2026-08-10 14:30:37",500,500,2,1,1,1,6215909,"0",null,null,null,null,null,[["Darovacia zmluva","6924608.pdf",10989391]],"bohunovo--roznava","rohoznik--malacky",null,0,null],[12469419,"26/43/054/954","Obec Bohúňovo","00328111","Bohúňovo 72, 04912 Bohúňovo","Úrad práce sociálnych vecí a rodiny Rožňava","30794536","Šafárikova 112, Rožňava","Dohoda o zabezpečení podmienok vykonávania aktivačnej činnosti formou menších obecných služieb pre obec a o poskytnutí príspevku na aktivačnú činnosť formou menších obecných služieb obci uzatvorená podľa § 54",null,null,"Úrad sa zaväzuje: \nPoskytnúť obci/ rozpočtovej organizácii zriadenej obcou / príspevkovej organizácii\nzriadenej obcou v zmysle projektu PUPN 4 príspevok na úhradu časti nákladov, ktoré\nsúvisia s vykonávaním aktivačnej činnosti, najviac vo výške 363,60 €, ak o príspevok\npožiadala.\nPri stanovení celkovej výšky poskytovaného príspevku podľa bodu 3. tohto článku tejto\ndohody zohľadniť dohodnutý týždenný rozsah vykonávania aktivačnej činnosti, termín\nzačatia vykonávania aktivačnej činnosti, dohodnutý počet UoZ uvedený v článku IV bod 3.\ntejto dohody, ako aj celkový počet UoZ, ktorí vykonávajú, resp. vykonávali aktivačnú\nčinnosť a taktiež skutočnosť, na aký čas bude UoZ zaradený na vykonávanie aktivačnej\nčinnosti. Po zohľadnení týchto skutočností vyplatiť obci / rozpočtovej organizácii zriadenej\nobcou / príspevkovej organizácii zriadenej obcou mesačne príspevok za (jedného) 1 UoZ\nvykonávajúceho aktivačnú činnosť v štruktúre: príspevok na úhradu časti nákladov, ktoré\nsúvisia s vykonávaním aktivačnej činnosti, najviac vo výške 0,5 % z celkovej ceny práce\nvypočítanej z priemernej mzdy zamestnanca v hospodárstve Slovenskej Republiky za prvý\naž tretí štvrťrok roku 2024, spolu mesačne za (jedného) 1 UoZ najviac vo výške 10,10 €,\nak o príspevok požiadala.",null,null,null,"2026-06-10","2026-06-17","2026-12-31","2026-06-16 09:57:38","2026-06-16 09:57:38",363.6,363.6,2,1,1,1,6215909,"0",null,null,null,null,null,[["Dohoda","6809600.pdf",824220]],"bohunovo--roznava","roznava--roznava","duplicita",1,[12450621,"26/43/054/954","c",1]],[12246255,"005/2026","Obec Bohúňovo","00328111","Bohúňovo 72, 04912 Bohúňovo","Fyzická osoba",null,null,"Nájomná zmluva",null,null,null,null,null,null,"2026-02-09","2026-04-21",null,"2026-04-20 13:36:10","2026-04-20 13:36:10",270,270,2,1,1,1,6215909,"0",null,null,null,null,null,[["Príloha č. 1","6680153.pdf",175892]],"bohunovo--roznava",null,null,0,null],[11841434,"26/43/054/3","Obec Bohúňovo","00328111","Bohúňovo 72, 04912 Bohúňovo","Úrad práce sociálnych vecí a rodiny Rožňava","30794536","Šafárikova 112, Rožňava","D O H O D A Číslo: 26/43/054/3",null,null,null,null,null,null,"2026-01-08","2026-01-13",null,"2026-01-12 15:21:09","2026-01-12 15:21:09",252.5,252.5,2,1,1,1,6215909,"0",null,null,null,null,null,[["D O H O D A Číslo: 26/43/054/3","6450289.pdf",634543]],"bohunovo--roznava","roznava--roznava","duplicita",1,[11834600,"26/43/054/3","c",1]],[12711191,"001/2026","Obec Bohúňovo","00328111","Bohúňovo 72, 04912 Bohúňovo","Fyzická osoba",null,null,"Zmluva o dielo",null,null,null,null,null,null,"2026-08-21","2026-08-25",null,"2026-08-24 12:22:16","2026-08-24 12:22:16",250,250,2,1,1,1,6215909,"0",null,null,null,null,null,[["Príloha č. 1","6947798.pdf",1653651]],"bohunovo--roznava",null,null,0,null],[12699137,"022/2026","Obec Bohúňovo","00328111","Bohúňovo 72, 04912 Bohúňovo","Comba s.r.o.","536